# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Auth
LIFECYCLE_ADMIN_PASSWORD=changeme
TOKEN_SIGNING_SECRET=shared-secret-with-lifecycle-app

# CRM bridge — required for Send via Pinnacle (CRM builds reminder PDF + calls Pinnacle)
# Local: CRM on 3002, lifecycle on 3001 (port 3000 is often used by other apps)
CRM_BASE_URL=http://localhost:3002
CRM_WEBHOOK_SECRET=shared-secret-with-lifecycle-app
LIFECYCLE_APP_URL=http://localhost:3001

# Optional: direct Pinnacle keys (used by /api/whatsapp/channel-test only)
# PINNACLE_PHONE_ID=
# PINNACLE_API_KEY=
# PINNACLE_TEMPLATE_NAME=invoice_from_crm_testing_template
# PINNACLE_TEMPLATE_LANGUAGE=en

# Cron (Vercel sets this automatically; optional for local)
CRON_SECRET=
